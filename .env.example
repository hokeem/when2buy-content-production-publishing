# Apify token for public benchmark-feed collection. Keep the real value outside Git.
APIFY_TOKEN=
# Optional: use a replacement only after validating its output schema.
APIFY_ACTOR_ID=apidojo/twitter-profile-scraper
# Postiz is used only by scripts/postiz_publish.py; keep the real value outside Git.
POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
WHEN2BUY_POSTIZ_HANDLE=_When2buy
# Set only in the protected runtime environment used by the scheduled publisher.
# This is a standing authorization flag, never a substitute for the validation gates.
WHEN2BUY_AUTOPUBLISH_ENABLED=false
# Hard source-age limit; stale unsent packages are expired and never backfilled.
WHEN2BUY_SOURCE_TTL_MINUTES=90
# Never place GitHub tokens, X cookies, passwords, or browser profiles in this repository.
